# Exemplo de configuração. NÃO é necessário copiar manualmente:
# os instaladores (install.bat / install.sh) geram config/config.ini
# executando:  python -m mt5_extracao.bootstrap configure
#
# [MT5]       path = pasta com terminal64.exe no sistema (no Linux: dentro do prefixo Wine)
#             windows_path / wine_prefix = usados apenas no Linux (Wine)
# [BRIDGE]    ponte RPyC para acessar o MT5 do Wine a partir do Linux
# [DATABASE]  type = sqlite; path relativo à raiz do projeto
# [EXTRACTION] tamanho dos blocos (dias) por timeframe
# [FALLBACK]  fonte externa para lacunas M1: "Dummy" (teste) ou "Csv" (arquivos em csv_dir)
# [APP]       horário do pregão (HH:MM) usado pelo relatório de qualidade (lacunas);
#             time_basis: broker (horário da corretora, padrão) ou utc; broker_utc_offset: fuso (B3 = -3)
# Credenciais NÃO ficam aqui: use o arquivo .env (veja .env.example).

[MT5]
path = C:\Program Files\MetaTrader 5
windows_path = C:\Program Files\MetaTrader 5
wine_prefix = 
# MT5 oculto: true = o terminal, o MetaEditor e o Strategy Tester rodam sem ocupar a tela. No Linux usam uma
# tela virtual (precisa do Xvfb); no Windows o terminal abre minimizado. Para ver o que o MT5 oculto está
# mostrando: mt5x mt5 show. Para uma execução só: MT5X_HIDDEN=1 mt5x ...  (MT5X_HIDDEN=0 desliga).
hidden = false
hidden_display = :99
# Organização da janela do MT5 ao iniciar um robô (mt5x robots start): fecha a Observação do Mercado, o Navegador, a
# Caixa de Ferramentas e o Testador, esconde as barras de ferramentas e abre o gráfico do robô sozinho e maximizado,
# num perfil de gráficos próprio ("HADOUKEN"); o seu perfil e o seu arranjo são guardados e voltam quando desligar.
# false desliga. O botão TELA do painel do HADOUKEN desliga e liga a mesma coisa.
manage_layout = true
# Cada parte da organização pode ser desligada sozinha (também em Arquivo > Configurações, na interface; para ver
# o estado: mt5x mt5 layout). Uma parte desligada depois de já ter sido escondida volta como você tinha deixado.
# Observação do Mercado e Navegador (lateral esquerda):
layout_hide_navigation = true
# Caixa de Ferramentas e Testador de Estratégia (parte de baixo):
layout_hide_toolbox = true
# Barras de ferramentas (o menu Exibir do MT5 as traz de volta):
layout_hide_toolbars = true
# Gráfico do robô sozinho e maximizado, no perfil de gráficos "HADOUKEN". false = o gráfico do robô é aberto no
# perfil em que o terminal estava, e cada início acrescenta um gráfico a ele.
layout_own_profile = true
# Disposição do painel do HADOUKEN (parâmetro InpPanelLayout do robô): auto (pelo tamanho do gráfico), compact,
# normal ou wide. Vale quando o programa inicia o robô do painel e em "Abrir visão MT5" (mt5x mt5 view).
panel_layout = auto
# "Abrir visão MT5" (e a abertura do programa) põe o painel no gráfico. Se o painel não tiver a bateria de segurança
# aprovada, ele entra SÓ PARA VISUALIZAÇÃO: o PARAR TUDO é acionado (nenhum robô do HADOUKEN opera) e o painel
# aparece BLOQUEADO até você liberar com 'mt5x robots stop --release'. Exige conta de demonstração, o painel
# compilado e a leitura do código aprovada (mt5x robots battery <painel>). false = só o gráfico.
view_panel = true
# Qual robô do catálogo é o painel (mt5x robots list) e com qual preset ele entra (vazio = padrão do código).
panel_robot = hdk_hadouken_painel
panel_preset =

[BRIDGE]
enabled = false
host = 127.0.0.1
port = 18812
wine_python = 

[DATABASE]
# sqlite (padrão, um arquivo) ou postgresql (servidor; TimescaleDB é usado se a extensão existir)
type = sqlite
path = database/mt5_data.db
# PostgreSQL: postgresql://usuario@localhost:5432/mt5 — a senha vai em DB_PASSWORD no arquivo .env
url = 

[EXTRACTION]
chunk_days_m1 = 30
chunk_days_m5_m15 = 90
chunk_days_default = 365

[FALLBACK]
external_source_m1_fallback_enabled = False
# Dummy (teste) ou Csv. Com Csv, coloque <símbolo>.csv (ou a exportação de barras do MT5) em csv_dir
external_source_m1_type = Dummy
csv_dir = 

[APP]
session_start = 09:00
session_end = 18:30
time_basis = broker
broker_utc_offset = -3
# Onde fica o banco quando [DATABASE] path é relativo: vazio = pasta do projeto (padrão);
# auto = pasta de dados do usuário (%LOCALAPPDATA%\mt5-extracao, ~/.local/share/mt5-extracao); ou um caminho.
# Um banco que já exista na pasta do projeto continua sendo usado.
data_dir = 
# Avisos em pop-up do sistema ao fim de cada ação (extração, compilação, teste, bateria, início e parada de robô)
# e, com 'mt5x robots monitor <robô> --watch', a cada operação do robô. Sem sessão gráfica vira só registro em log.
notifications = true

[STRATEGY]
# Backtest e validação (mt5x backtest / validate / report)
initial_equity = 100000
risk_per_trade = 0.01
commission_per_lot = 0
slippage_points = 0
max_drawdown = 0.20
min_profit_factor = 1.3
min_trades = 100

[SCREENER]
# Triagem de ativos (mt5x screen). portfolio: símbolos separados por vírgula.
# events_file: CSV opcional com colunas time,symbol,impact (impacto "alto" bloqueia o ativo)
max_spread_atr = 0.10
min_liquidity_percentile = 30
max_bad_bars = 0.01
min_years_daily = 3
min_years_intraday = 1
spike_multiple = 3
max_spike_share = 0.02
max_correlation = 0.7
portfolio = 
events_file = 
event_window_hours = 4

[ROBOTS]
# Catálogo de robôs (mt5x robots list). library_dirs: pastas com robôs MQL5, separadas por ponto e vírgula.
# Cada pasta segue o layout do MT5 (Experts/, Include/, Presets/), como o clone do projeto-indicadores-mt5.
library_dirs = 
# MetaEditor usado por 'mt5x robots compile'. Vazio = MetaEditor64.exe da pasta do MT5 ([MT5] path).
metaeditor_path = 
# Modelo do Strategy Tester em 'mt5x robots backtest' de robô MQL5: 4 = cada tick com ticks reais (padrão, o mais
# fiel), 0 = cada tick. Os modelos 1 (OHLC de 1 minuto) e 2 (só preços de abertura) são mais rápidos, mas
# preenchem um stop atravessado por gap no preço do stop, escondendo perda: a bateria de segurança não os aceita.
tester_model = 4
# Teto de risco por operação (%) aceito pela bateria de segurança ('mt5x robots battery').
max_real_risk_pct = 1.0
# mt5x portfolio: estado ALERTA quando o risco de TODA a conta até o stop (posições e ordens pendentes, de todos os
# robôs e manuais) passar deste percentual do saldo. 0 = não compara. Só avisa: nada é bloqueado.
max_account_risk_pct = 0
# Pasta de um clone de https://github.com/Misael-art/mt5x-safety (biblioteca de segurança MQL5).
# O mt5x instala dela a versão que cada robô declara em "safety_lib" no robot.json. Vazio = não usa.
safety_lib_dir = 
