#property strict
#include "$safety"

input string UltraBinarySha="";
const string UltraManifest="$manifest", UltraBinding="$binding", UltraClosure="$closure";
const string UltraPresetSha="$preset_sha";
const int UltraPresetVersion=$preset_version;
const long UltraStart=$start, UltraEnd=$end, UltraLast=$last, UltraTickCount=$tick_count;
const string UltraPrefix="MT5X_ULTRA_PORTFOLIO|";
CHDKPortfolioRiskGuard ultra_leader;
ulong ultra_chart=0;
int ultra_tape=INVALID_HANDLE, ultra_peak=0;
long ultra_ticks=0, ultra_msc=0;
bool ultra_failed=false, ultra_completed=false;
datetime ultra_heartbeat=0;
datetime ultra_latest_rate=0;

bool UltraReconcile(string &reason)
{
   if(!ultra_leader.RefreshLeader(ultra_chart)) {reason="pulso do controlador indisponível"; return false;}
   bool ok=ultra_leader.ReconcileReservations(reason);
   if(!ok && reason=="") reason="reservas da carteira aguardam conciliação";
   return ok;
}

bool UltraBind(CHDKPortfolioRiskGuard &guard,CHDKSafeExecutor &exec,const long magic,const string key,
               const string preset,const string inputs)
{
   string reason;
   bool ok=guard.BindContext(magic,UltraBinding,key,"mt5x-ultra-eurusd",preset,UltraPresetVersion,UltraClosure,UltraBinarySha,inputs,reason)
           && exec.BindPortfolio(GetPointer(guard),reason);
   Print(UltraPrefix,"OWNER|",magic,"|",key,"|",(int)ok,"|",reason);
   Print(UltraPrefix,"INPUTS|",magic,"|",preset,"|",inputs);
   return ok;
}

void UltraRates(const MqlRates &rates[],const int n)
{
   for(int i=0;i<n;i++)
   {
      if(rates[i].time<=ultra_latest_rate) continue;
      PrintFormat("%sRATE|%I64d|%.17g|%.17g|%.17g|%.17g|%I64d|%I64d",UltraPrefix,(long)rates[i].time,
                  rates[i].open,rates[i].high,rates[i].low,rates[i].close,
                  rates[i].tick_volume,rates[i].real_volume);
      ultra_latest_rate=rates[i].time;
   }
}

