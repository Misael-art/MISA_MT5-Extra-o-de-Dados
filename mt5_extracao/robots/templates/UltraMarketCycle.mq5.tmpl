#property strict
#include "HADOUKEN/Strategies/HDK_S09Reference.mqh"
#include "HDK_ExecutionResult.mqh"

const string Audit="MT5X_ULTRA_MARKET_CYCLE|";
const string Manifest="$manifest", Binding="$binding";
const long FromMsc=$start, ToMsc=$end;
const double TickSize=$tick_size, Lot=$lot, Risk=$risk;
const ulong Magic=91511725;
const int FastN=$fast, SlowN=$slow, Warmup=$warmup, StopTicks=$stop, TargetTicks=$target;
int bars=0;
long minute=0;
double last_bid=0, fast_ema=0, slow_ema=0;
bool attempted=false, ended=false, failed=false;

long Price(const double value) { return (long)MathRound(value/TickSize); }
long Money(const double value) { return (long)MathRound(value*100); }

int OnInit()
{
   if(!MQLInfoInteger(MQL_TESTER) || MQLInfoInteger(MQL_OPTIMIZATION)
      || _Symbol!="$symbol" || _Period!=PERIOD_M1 || SymbolInfoInteger(_Symbol,SYMBOL_CUSTOM)
      || AccountInfoInteger(ACCOUNT_TRADE_MODE)!=ACCOUNT_TRADE_MODE_DEMO
      || AccountInfoInteger(ACCOUNT_MARGIN_MODE)!=ACCOUNT_MARGIN_MODE_RETAIL_HEDGING
      || AccountInfoString(ACCOUNT_CURRENCY)!="USD" || Money(AccountInfoDouble(ACCOUNT_BALANCE))!=$capital
      || SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_SIZE)!=TickSize
      || SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN)!=Lot || SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP)!=Lot
      || SymbolInfoInteger(_Symbol,SYMBOL_TRADE_EXEMODE)!=SYMBOL_TRADE_EXECUTION_MARKET
      || (SymbolInfoInteger(_Symbol,SYMBOL_FILLING_MODE)&SYMBOL_FILLING_FOK)==0
      || OrdersTotal()!=0 || PositionsTotal()!=0) return INIT_FAILED;
   PrintFormat("%sBEGIN|%s|%s|%s|%d|%d|%d|%d|%d",Audit,Manifest,Binding,_Symbol,
               (int)TerminalInfoInteger(TERMINAL_BUILD),FastN,SlowN,Warmup,StopTicks);
   return INIT_SUCCEEDED;
}

void Submit(const MqlTick &tick,const int side)
{
   MqlTradeRequest request={};
   request.action=TRADE_ACTION_DEAL;
   request.type=(side>0 ? ORDER_TYPE_BUY : ORDER_TYPE_SELL);
   request.symbol=_Symbol;
   request.magic=Magic;
   request.volume=Lot;
   request.type_filling=ORDER_FILLING_FOK;
   double entry=(side>0 ? tick.ask : tick.bid);
   request.sl=NormalizeDouble((Price(entry)-side*StopTicks)*TickSize,_Digits);
   request.tp=NormalizeDouble((Price(entry)+side*TargetTicks)*TickSize,_Digits);
   double risk=0, margin=0, available=AccountInfoDouble(ACCOUNT_MARGIN_FREE);
   double budget=AccountInfoDouble(ACCOUNT_EQUITY)*Risk;
   bool allows=Price(tick.ask)-Price(tick.bid)<=$spread
       && OrderCalcProfit(request.type,_Symbol,Lot,entry,request.sl,risk)
       && OrderCalcMargin(request.type,_Symbol,Lot,entry,margin)
       && risk<0 && -risk<=budget && margin>0 && margin<=available
       && PositionsTotal()==0 && OrdersTotal()==0;
   PrintFormat("%sRISK|%I64d|%I64d|%I64d|%I64d|%I64d|%d",Audit,tick.time_msc,
               Money(-risk),Money(budget),Money(margin),Money(available),(int)allows);
   if(!allows) return;
   MqlTradeCheckResult check={};
   MqlTradeResult result={};
   bool checked=OrderCheck(request,check);
   bool sent=checked && OrderSend(request,result);
   HDKExecutionResultV1 observation;
   HDKExecutionResultObserve(request.volume,result,sent,(int)checked,TimeCurrent(),observation);
   PrintFormat("%sREQUEST|%I64d|%d|%I64d|%I64d|%I64d|%u|%u|%I64u|%I64u|%u|%d",
               Audit,tick.time_msc,side,Price(entry),Price(request.sl),Price(request.tp),
               check.retcode,result.retcode,result.order,result.deal,result.request_id,(int)observation.state);
   if(sent && PositionSelect(_Symbol) && (ulong)PositionGetInteger(POSITION_MAGIC)==Magic)
      PrintFormat("%sPOSITION|%I64u|%I64u|%I64d|%I64d|%I64d|%I64d",Audit,
                  (ulong)PositionGetInteger(POSITION_TICKET),(ulong)PositionGetInteger(POSITION_IDENTIFIER),
                  Price(PositionGetDouble(POSITION_PRICE_OPEN)),Price(PositionGetDouble(POSITION_SL)),
                  Price(PositionGetDouble(POSITION_TP)),Money(AccountInfoDouble(ACCOUNT_MARGIN)));
}

void OnTick()
{
   MqlTick tick={};
   if(!SymbolInfoTick(_Symbol,tick)) { failed=true; return; }
   if(tick.time_msc<FromMsc || failed) return;
   if(tick.time_msc>=ToMsc) { ended=true; return; }
   long now=tick.time_msc/60000;
   if(minute!=0 && now!=minute)
   {
      if(now!=minute+1) { failed=true; return; }
      double a=fast_ema,b=slow_ema;
      fast_ema=(bars==0 ? last_bid : (2.0/(FastN+1))*last_bid+(1.0-2.0/(FastN+1))*fast_ema);
      slow_ema=(bars==0 ? last_bid : (2.0/(SlowN+1))*last_bid+(1.0-2.0/(SlowN+1))*slow_ema);
      bars++;
      int side=(bars>=Warmup ? HDKS09Cross(a,b,fast_ema,slow_ema,bars,SlowN) : 0);
      PrintFormat("%sBAR|%I64d|%I64d|%I64d|%.16f|%.16f|%d",Audit,now*60000,tick.time_msc,
                  Price(last_bid),fast_ema,slow_ema,side);
      if(!attempted && side!=0) { attempted=true; Submit(tick,side); }
   }
   minute=now;
   last_bid=tick.bid;
}

void OnTradeTransaction(const MqlTradeTransaction &trans,const MqlTradeRequest &request,
                        const MqlTradeResult &result)
{
   if(trans.type!=TRADE_TRANSACTION_DEAL_ADD || !HistoryDealSelect(trans.deal)
      || (ulong)HistoryDealGetInteger(trans.deal,DEAL_MAGIC)!=Magic) return;
   ulong d=trans.deal;
   PrintFormat("%sDEAL|%I64u|%I64d|%I64u|%I64u|%d|%d|%d|%I64d|%I64d|%I64d|%I64d|%I64d|%I64d",
               Audit,d,HistoryDealGetInteger(d,DEAL_TIME_MSC),(ulong)HistoryDealGetInteger(d,DEAL_ORDER),
               (ulong)HistoryDealGetInteger(d,DEAL_POSITION_ID),(int)HistoryDealGetInteger(d,DEAL_ENTRY),
               (int)HistoryDealGetInteger(d,DEAL_TYPE),(int)HistoryDealGetInteger(d,DEAL_REASON),
               Price(HistoryDealGetDouble(d,DEAL_PRICE)),(long)MathRound(HistoryDealGetDouble(d,DEAL_VOLUME)/Lot),
               Money(HistoryDealGetDouble(d,DEAL_PROFIT)),Money(HistoryDealGetDouble(d,DEAL_COMMISSION)),
               Money(HistoryDealGetDouble(d,DEAL_SWAP)),Money(HistoryDealGetDouble(d,DEAL_FEE)));
}

void OnDeinit(const int reason)
{
   PrintFormat("%sEND|%s|%d|%d|%d|%I64d|%I64d|%d",Audit,Binding,bars,(int)ended,(int)failed,
               Money(AccountInfoDouble(ACCOUNT_BALANCE)),Money(AccountInfoDouble(ACCOUNT_EQUITY)),PositionsTotal());
}
