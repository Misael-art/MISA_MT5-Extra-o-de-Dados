#property strict
#property version "1.00"
#include "HDK_ExecutionResult.mqh"

$runtime

const string audit="MT5X_ULTRA_ORDERS1|";
bool platform_active=false, uncertain=false;
long last_requested[OWNER_COUNT];

bool TesterContext()
{
   return MQLInfoInteger(MQL_TESTER) && !MQLInfoInteger(MQL_OPTIMIZATION)
      && _Symbol=="$symbol" && _Period==PERIOD_M1 && SymbolInfoInteger(_Symbol,SYMBOL_CUSTOM);
}

long PriceTicks(const double value) { return (long)MathRound(value/TICK_SIZE); }
long VolumeSteps(const double value) { return (long)MathRound(value/$volume_step); }
long Cents(const double value) { return (long)MathRound(value*100); }

void PlatformRequest(MqlTradeRequest &request,const int slot,const long opened)
{
   if(!platform_active || !TesterContext()) return;
   MqlTradeCheckResult check={};
   MqlTradeResult result={};
   bool checked=OrderCheck(request,check);
   bool sent=false;
   if(checked) sent=OrderSend(request,result);
   HDKExecutionResultV1 observation;
   HDKExecutionResultObserve(request.volume,result,sent,(int)checked,TimeCurrent(),observation);
   PrintFormat("%sREQUEST|%I64d|%d|%d|%I64d|%s|%I64u|%I64u|%s|%I64d|%I64d|%I64d|%I64d|%u|%d|%u|%I64u|%I64u|%u|%d",
               audit,book.msc,book.seq,slot,opened,EnumToString(request.action),request.order,request.position,
               EnumToString(request.type),VolumeSteps(request.volume),PriceTicks(request.price),PriceTicks(request.sl),
               PriceTicks(request.tp),check.retcode,(int)sent,result.retcode,result.order,result.deal,result.request_id,
               (int)observation.state);
   if(checked && (result.retcode==TRADE_RETCODE_TIMEOUT || result.retcode==TRADE_RETCODE_CONNECTION
                  || result.retcode==0)) uncertain=true;
}

void PlatformIntent(const long msc,const int sequence,const int slot,const long opened,const string kind,
                    const long side,const long limit,const long qty,const long sl,const long tp)
{
   if(!platform_active || slot<0 || !TesterContext()) return;
   if(kind!="order" && kind!="cancel" && kind!="management") return;
   ulong magic=(ulong)(opened*MAGIC_STRIDE+slot);
   bool occupied=false, protected_book=true, found_target=false;
   long risk=0,reserved=0;
   long spread_cost=(book.ask-book.bid)*TICK_CASH;

   bool hedging=AccountInfoInteger(ACCOUNT_MARGIN_MODE)==ACCOUNT_MARGIN_MODE_RETAIL_HEDGING;
   MqlTradeRequest req={}; req.symbol=_Symbol; req.magic=magic;
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      ulong ticket=OrderGetTicket(i);
      if(!ticket || OrderGetString(ORDER_SYMBOL)!=_Symbol) continue;
      ulong id=(ulong)OrderGetInteger(ORDER_MAGIC);
      occupied|=(!hedging || id%MAGIC_STRIDE==(ulong)slot);
      long pending=VolumeSteps(OrderGetDouble(ORDER_VOLUME_CURRENT));
      long price=PriceTicks(OrderGetDouble(ORDER_PRICE_OPEN)),stop=PriceTicks(OrderGetDouble(ORDER_SL));
      long dir=(OrderGetInteger(ORDER_TYPE)==ORDER_TYPE_BUY_LIMIT ? 1 : -1);
      if(stop<=0) protected_book=false;
      long gap=dir*(price-stop);
      risk+=pending*((gap>0 ? gap : 0)*TICK_CASH+2*(long)FEE);
      reserved+=pending*(MARGIN_STEP+spread_cost+FEE);
      if(kind=="cancel" && id==magic)
      {
         found_target=true;req.action=TRADE_ACTION_REMOVE;req.order=ticket;
         PlatformRequest(req,slot,opened);
      }
   }
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong ticket=PositionGetTicket(i);
      if(!ticket || PositionGetString(POSITION_SYMBOL)!=_Symbol) continue;
      ulong id=(ulong)PositionGetInteger(POSITION_MAGIC);
      occupied|=(!hedging || id%MAGIC_STRIDE==(ulong)slot);
      long held=VolumeSteps(PositionGetDouble(POSITION_VOLUME)),stop=PriceTicks(PositionGetDouble(POSITION_SL));
      long gap=(PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY ? book.bid-stop : stop-book.ask);
      if(stop<=0) protected_book=false;
      risk+=held*((gap>0 ? gap : 0)*TICK_CASH+FEE);
      reserved+=held*MARGIN_STEP;
      if(kind=="management" && id==magic)
      {
         found_target=true;req.action=TRADE_ACTION_SLTP;req.position=ticket;req.sl=(double)sl*TICK_SIZE;req.tp=(double)tp*TICK_SIZE;
         PlatformRequest(req,slot,opened);
      }
   }
   if(kind!="order")
   {
      if(!found_target) PrintFormat("%sVETO|%I64d|%d|%d|%I64d|%s",audit,msc,sequence,slot,opened,
                                    kind=="cancel" ? "pending_ticket_missing" : "position_ticket_missing");
      return;
   }
   string veto="";
   if(uncertain) veto="request_outcome_unknown";
   else if(occupied) veto=(hedging ? "owner_still_exposed" : "netting_independent_protection");
   else if(!protected_book) veto="platform_unprotected_exposure";
   else if(risk+qty*(side*(limit-sl)*TICK_CASH+2*(long)FEE)>RISK_LIMIT) veto="platform_shared_risk";
   else if(reserved+qty*(MARGIN_STEP+spread_cost+FEE)>Cents(AccountInfoDouble(ACCOUNT_EQUITY))) veto="platform_shared_margin";
   else if(last_requested[slot]>=opened) veto="cycle_already_submitted";
   else if(!HistorySelect(0,TimeCurrent())) veto="history_unavailable";
   else
      for(int i=HistoryOrdersTotal()-1;i>=0;i--)
      {
         ulong ticket=HistoryOrderGetTicket(i);
         if(HistoryOrderGetString(ticket,ORDER_SYMBOL)==_Symbol && (ulong)HistoryOrderGetInteger(ticket,ORDER_MAGIC)==magic)
         { veto="cycle_already_submitted";break; }
      }
   if(veto!="")
   {
      PrintFormat("%sVETO|%I64d|%d|%d|%I64d|%s",audit,msc,sequence,slot,opened,veto);
      return;
   }
   last_requested[slot]=opened;
   req.action=TRADE_ACTION_PENDING;req.type=(side>0 ? ORDER_TYPE_BUY_LIMIT : ORDER_TYPE_SELL_LIMIT);
   req.type_filling=ORDER_FILLING_RETURN;req.type_time=ORDER_TIME_GTC;
   req.volume=(double)qty*$volume_step;req.price=(double)limit*TICK_SIZE;req.sl=(double)sl*TICK_SIZE;req.tp=(double)tp*TICK_SIZE;
   req.comment=StringFormat("UX:%d:%I64d",slot,opened);
   PlatformRequest(req,slot,opened);
}

void Snapshot()
{
   int orders=0,positions=0;
   for(int i=0;i<OrdersTotal();i++)
   {
      ulong t=OrderGetTicket(i);
      if(!t || OrderGetString(ORDER_SYMBOL)!=_Symbol) continue;
      PrintFormat("%sORDER|%I64d|%d|%I64u|%I64d|%s|%I64d|%I64d|%I64d|%I64d",audit,last_msc,seq,t,
                  OrderGetInteger(ORDER_MAGIC),EnumToString((ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE)),
                  VolumeSteps(OrderGetDouble(ORDER_VOLUME_CURRENT)),PriceTicks(OrderGetDouble(ORDER_PRICE_OPEN)),
                  PriceTicks(OrderGetDouble(ORDER_SL)),PriceTicks(OrderGetDouble(ORDER_TP)));orders++;
   }
   for(int i=0;i<PositionsTotal();i++)
   {
      ulong t=PositionGetTicket(i);
      if(!t || PositionGetString(POSITION_SYMBOL)!=_Symbol) continue;
      PrintFormat("%sPOSITION|%I64d|%d|%I64u|%I64d|%I64d|%s|%I64d|%.12f|%I64d|%I64d",audit,last_msc,seq,t,
                  PositionGetInteger(POSITION_MAGIC),PositionGetInteger(POSITION_IDENTIFIER),
                  EnumToString((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE)),VolumeSteps(PositionGetDouble(POSITION_VOLUME)),
                  PositionGetDouble(POSITION_PRICE_OPEN),PriceTicks(PositionGetDouble(POSITION_SL)),PriceTicks(PositionGetDouble(POSITION_TP)));positions++;
   }
   PrintFormat("%sACCOUNT|%I64d|%d|%I64d|%I64d|%I64d|%d|%d",audit,last_msc,seq,
               Cents(AccountInfoDouble(ACCOUNT_BALANCE)),Cents(AccountInfoDouble(ACCOUNT_EQUITY)),
               Cents(AccountInfoDouble(ACCOUNT_MARGIN)),orders,positions);
}

int OnInit()
{
   if(!TesterContext() || SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_SIZE)!=TICK_SIZE ||
      MathAbs(SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP)-$volume_step)>1e-10 ||
      AccountInfoString(ACCOUNT_CURRENCY)!="$currency" || Cents(AccountInfoDouble(ACCOUNT_BALANCE))!=INITIAL_CASH ||
      PositionsTotal()!=0 || OrdersTotal()!=0) return INIT_FAILED;
   const long required=SYMBOL_ORDER_LIMIT|SYMBOL_ORDER_SL|SYMBOL_ORDER_TP;
   if(SymbolInfoInteger(_Symbol,SYMBOL_TRADE_MODE)!=SYMBOL_TRADE_MODE_FULL ||
      (SymbolInfoInteger(_Symbol,SYMBOL_ORDER_MODE)&required)!=required)
   { Print(audit,"INIT_VETO|symbol_order_capabilities");return INIT_FAILED; }
   BeginCapture();platform_active=true;
   PrintFormat("%sBEGIN|$package|$manifest|$revision|%s|%d|%s|%s|%I64d",audit,_Symbol,
               (int)TerminalInfoInteger(TERMINAL_BUILD),EnumToString((ENUM_ACCOUNT_MARGIN_MODE)AccountInfoInteger(ACCOUNT_MARGIN_MODE)),
               AccountInfoString(ACCOUNT_CURRENCY),Cents(AccountInfoDouble(ACCOUNT_BALANCE)));
   return INIT_SUCCEEDED;
}

void OnTick()
{
   if(!platform_active) return;
   MqlTick quote;
   if(!SymbolInfoTick(_Symbol,quote)) failed=true;
   int previous=frames;
   if(!failed) ObserveQuote(quote);
   if(frames>previous) Snapshot();
   if(failed) TesterStop();
}

void OnTradeTransaction(const MqlTradeTransaction &trans,const MqlTradeRequest &req,const MqlTradeResult &res)
{
   bool response=(trans.type==TRADE_TRANSACTION_REQUEST);
   if(!platform_active || (response ? req.symbol!=_Symbol : trans.symbol!=_Symbol)) return;
   PrintFormat("%sTX|%s|%I64u|%I64u|%I64u|%I64u|%u|%u|%I64d|%I64d",audit,EnumToString(trans.type),
               response ? res.order : trans.order,response ? res.deal : trans.deal,response ? req.position : trans.position,
               response ? req.magic : 0,response ? res.request_id : 0,response ? res.retcode : 0,
               VolumeSteps(response ? res.volume : trans.volume),PriceTicks(response ? res.price : trans.price));
}

void OnDeinit(const int reason)
{
   if(!platform_active) return;
   bool history=HistorySelect(0,TimeCurrent());
   int orders=0,deals=0;
   for(int i=0;history && i<HistoryOrdersTotal();i++)
   {
      ulong t=HistoryOrderGetTicket(i);
      if(!t || HistoryOrderGetString(t,ORDER_SYMBOL)!=_Symbol) continue;
      PrintFormat("%sHISTORY|%I64u|%I64d|%I64d|%s|%s|%I64d|%I64d|%I64d|%I64d|%I64d",audit,t,
                  HistoryOrderGetInteger(t,ORDER_MAGIC),HistoryOrderGetInteger(t,ORDER_POSITION_ID),
                  EnumToString((ENUM_ORDER_STATE)HistoryOrderGetInteger(t,ORDER_STATE)),
                  EnumToString((ENUM_ORDER_TYPE)HistoryOrderGetInteger(t,ORDER_TYPE)),HistoryOrderGetInteger(t,ORDER_TIME_DONE_MSC),
                  VolumeSteps(HistoryOrderGetDouble(t,ORDER_VOLUME_INITIAL)),VolumeSteps(HistoryOrderGetDouble(t,ORDER_VOLUME_CURRENT)),
                  PriceTicks(HistoryOrderGetDouble(t,ORDER_SL)),PriceTicks(HistoryOrderGetDouble(t,ORDER_TP)));orders++;
   }
   for(int i=0;history && i<HistoryDealsTotal();i++)
   {
      ulong t=HistoryDealGetTicket(i);
      if(!t || HistoryDealGetString(t,DEAL_SYMBOL)!=_Symbol) continue;
      PrintFormat("%sDEAL|%I64u|%I64d|%I64d|%I64d|%I64d|%s|%s|%s|%I64d|%I64d|%I64d|%I64d|%I64d|%I64d",audit,t,
                  HistoryDealGetInteger(t,DEAL_ORDER),HistoryDealGetInteger(t,DEAL_POSITION_ID),HistoryDealGetInteger(t,DEAL_MAGIC),
                  HistoryDealGetInteger(t,DEAL_TIME_MSC),EnumToString((ENUM_DEAL_ENTRY)HistoryDealGetInteger(t,DEAL_ENTRY)),
                  EnumToString((ENUM_DEAL_TYPE)HistoryDealGetInteger(t,DEAL_TYPE)),EnumToString((ENUM_DEAL_REASON)HistoryDealGetInteger(t,DEAL_REASON)),
                  VolumeSteps(HistoryDealGetDouble(t,DEAL_VOLUME)),PriceTicks(HistoryDealGetDouble(t,DEAL_PRICE)),
                  Cents(HistoryDealGetDouble(t,DEAL_COMMISSION)),Cents(HistoryDealGetDouble(t,DEAL_FEE)),
                  Cents(HistoryDealGetDouble(t,DEAL_SWAP)),Cents(HistoryDealGetDouble(t,DEAL_PROFIT)));deals++;
   }
   PrintFormat("%sEND|%d|%d|%d|%d|%I64d|%I64d",audit,frames,(int)history,orders,deals,Cents(AccountInfoDouble(ACCOUNT_BALANCE)),Cents(AccountInfoDouble(ACCOUNT_EQUITY)));
   EndCapture();platform_active=false;
}
