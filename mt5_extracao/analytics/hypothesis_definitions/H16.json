{
  "pattern_id": "H16",
  "title": "Atraso de entrada e degradação de expectativa",
  "version": "0.1",
  "status": "DRAFT",
  "sample_builder": "H16",
  "inputs": {"signal_events_required": ["signal_time", "direction", "exit_time"],
              "optional_fields": ["symbol", "strategy_id", "signal_id"],
