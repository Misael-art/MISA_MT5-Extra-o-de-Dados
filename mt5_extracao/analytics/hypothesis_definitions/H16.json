  "validation": {"horizon_minutes": 1440, "min_samples": 30, "min_sessions": 60, "alpha": 0.05,
                  "parameter_selection": "train_only"},
  "target": {"field": "outcome_return", "operator": "gt", "value": 0},
  "outcome": {"field": "outcome_return", "type": "declared_signal_exit_with_entry_delays", "net_of_observed_spread": true}
}
