{
  "pattern_id": "H03",
  "title": "Queda de volume por três semanas e rompimento",
  "version": "1.0",
  "status": "EXPLORATORY",
  "sample_builder": "H03",
  "universe": {"timeframes": ["M1"], "minimum_sessions": 60, "markets": "declared_by_run"},
  "session": {"source": "observed_m1", "timezone": "broker", "session_anchor": "00:00"},
  "condition": {"field": "volume_decline_ratio", "operator": "lt", "parameter": "volume_decline_threshold"},
  "trigger": {"type": "session_open", "known_at": "previous_session_close"},
  "entry": {"type": "opening_range_breakout", "minutes_parameter": "opening_range_minutes",
            "direction": "first_close_outside_range_next_open"},
  "exit": {"type": "observed_session_close"},
  "costs": {"spread": "observed_m1", "slippage_bps": 0, "commission_bps": 0,
            "missing_components": ["slippage", "commission"]},
  "parameters": {"recent_sessions": 15, "baseline_sessions": 20, "maximum_baseline_sessions": 60,
                 "opening_range_minutes": 30,
                 "volume_decline_threshold": 1.0,
                 "normalization": "observed_minutes_and_weekday", "threshold_provenance": "exploratory"},
  "parameter_grid": {"volume_decline_threshold": [0.8, 1.0, 1.2]},
  "validation": {"horizon_minutes": 1440, "min_samples": 30, "min_sessions": 60, "alpha": 0.05,
                  "bootstrap_block": "session", "parameter_selection": "train_only"},
  "target": {"field": "breakout_success", "operator": "eq", "value": true},
  "outcome": {"field": "breakout_return", "type": "opening_range_breakout_proxy", "net_of_observed_spread": true}
}
