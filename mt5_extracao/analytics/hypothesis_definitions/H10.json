{
  "pattern_id": "H10",
  "title": "Recuperação após queda percentual ou em ATR",
  "version": "0.1",
  "status": "DRAFT",
  "sample_builder": "DRAFT",
  "universe": {"timeframes": ["M1"], "markets": "declared_by_run"},
  "session": {"source": "observed_m1", "timezone": "broker", "session_anchor": "00:00"},
  "condition": {"operator": "and", "conditions": [
    {"field": "drawdown_pct_from_prior_peak", "operator": "lte", "value": -0.01},
    {"field": "drawdown_atr_from_prior_peak", "operator": "lte", "value": -1.5}
  ]},
  "trigger": {"type": "closed_m1_bar", "peak_and_drawdown_are_point_in_time": true},
  "entry": {"type": "next_m1_bar_open", "direction": "strategy_signal"},
  "exit": {"type": "recovery_or_fixed_horizon", "recovery_bars": 20, "horizon_minutes": 60},
  "costs": {"spread": "observed_m1", "slippage_bps": 0, "commission_bps": 0,
            "missing_components": ["slippage", "commission"]},
  "parameters": {"drawdown_pct": -0.01, "drawdown_atr": -1.5, "recovery_bars": 20,
                 "threshold_provenance": "unmeasured_draft"},
  "validation": {"horizon_minutes": 60, "min_samples": 30, "min_sessions": 60, "alpha": 0.05,
                  "parameter_selection": "train_only"},
  "target": {"field": "net_return", "operator": "gt", "value": 0},
  "outcome": {"field": "net_return", "type": "DRAFT", "net_of_observed_spread": true}
}
